# Set to true only after every reference below is supplied by deployment.
HIDDENSHIELD_AI_TRANSPARENCY_CUSTODY_ENABLED=true

# Internal IAM receipt verification; HTTPS endpoints only.
HIDDENSHIELD_AI_IAM_RECEIPT_URL=https://iam.example.internal/receipts
HIDDENSHIELD_AI_IAM_ISSUER=https://iam.example.internal
HIDDENSHIELD_AI_IAM_AUDIENCE=hiddenshield-ai-custody
HIDDENSHIELD_AI_IAM_JWKS_URL=https://iam.example.internal/.well-known/jwks.json

# KMS/HSM references only. Never place pepper material or provider credentials here.
HIDDENSHIELD_AI_KMS_PROVIDER=gcp_kms
HIDDENSHIELD_AI_KMS_ACTIVE_PEPPER_REF=gcp-kms://projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/AI_CUSTODY_PEPPER/cryptoKeyVersions/VERSION
HIDDENSHIELD_AI_KMS_RETAINED_PEPPER_REFS=["gcp-kms://projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/AI_CUSTODY_PEPPER/cryptoKeyVersions/RETAINED_VERSION"]
HIDDENSHIELD_AI_KMS_WORKLOAD_IDENTITY_REF=gcp-wif://projects/PROJECT_ID/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
HIDDENSHIELD_AI_KMS_HEALTH_URL=https://kms.example.internal/health

# Immutable runbook reference used for provider outage and pepper retirement exercises.
HIDDENSHIELD_AI_PROVIDER_RECOVERY_RUNBOOK_REF=runbook://ai-custody/provider-recovery-v1
