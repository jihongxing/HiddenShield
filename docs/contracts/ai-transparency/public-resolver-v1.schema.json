{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiddenshield.internal/contracts/ai-transparency/public-resolver-v1.schema.json",
  "title": "HiddenShield AI Transparency Public Resolver v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "resolutionStatus",
        "manifestId",
        "watermarkUid",
        "manifestStatus",
        "claimType",
        "markerStatus",
        "metadataSignatureStatus",
        "watermarkDetectionStatus",
        "issuerTrustStatus",
        "evidenceLevel",
        "evidenceVerificationStatus",
        "generatedAt",
        "profiles",
        "markers",
        "legalConclusion",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hs-ai-public-resolver-v1"
        },
        "resolutionStatus": {
          "const": "confirmed"
        },
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "watermarkUid": {
          "type": "string",
          "pattern": "^HS-[A-F0-9]{8}-[A-F0-9]{8}-[A-F0-9]{8}-[A-F0-9]{8}$"
        },
        "manifestStatus": {
          "enum": [
            "active",
            "superseded",
            "revoked",
            "disputed"
          ]
        },
        "claimType": {
          "enum": [
            "ai_generated",
            "ai_manipulated"
          ]
        },
        "markerStatus": {
          "enum": [
            "present_verified",
            "present_unverified",
            "not_present"
          ]
        },
        "metadataSignatureStatus": {
          "enum": [
            "verified",
            "not_present"
          ]
        },
        "watermarkDetectionStatus": {
          "enum": [
            "verified",
            "not_present"
          ]
        },
        "issuerTrustStatus": {
          "const": "not_evaluated"
        },
        "evidenceLevel": {
          "type": "string",
          "minLength": 1
        },
        "evidenceVerificationStatus": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profileId",
              "status"
            ],
            "properties": {
              "profileId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "markerType",
              "profileId",
              "version",
              "verificationStatus"
            ],
            "properties": {
              "markerType": {
                "type": "string",
                "minLength": 1
              },
              "profileId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "verificationStatus": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "legalConclusion": {
          "const": false
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "resolutionStatus",
        "legalConclusion",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hs-ai-public-resolver-v1"
        },
        "resolutionStatus": {
          "enum": [
            "not_found",
            "unavailable"
          ]
        },
        "legalConclusion": {
          "const": false
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
